<% content_for(:title, 'ログイン') %>
<% @simple_header = true %>

<div class="form-container">
  <h2 class="form-title">ログイン</h2>
  
  <%= form_with url: login_path, local: true, class: 'user-form' do |f| %>
    <div class="form-group">
      <%= f.label :email, 'メールアドレス', class: 'form-label' %>
      <%= f.email_field :email, class: 'form-input', placeholder: 'example@email.com' %>
    </div>

    <div class="form-group">
      <%= f.label :password, 'パスワード', class: 'form-label' %>
      <%= f.password_field :password, class: 'form-input', placeholder: 'パスワードを入力' %>
    </div>

    <div class="form-actions">
      <%= f.submit 'ログイン', class: 'btn-primary' %>
    </div>
  <% end %>
  
  <div class="form-footer">
    <p>新規登録がまだの方は<%= link_to 'こちら', new_user_path, class: 'form-link' %></p>
  </div>
</div>