<div class="container mx-auto px-4 py-8">
  <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold mb-6 text-center">家族コード入力</h1>
    
    <div class="mb-6">
      <p class="text-gray-700 mb-4">
        パートナーから共有された家族コードを入力してください。
      </p>
      
      <% if current_user.family.present? %>
        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4">
          <p class="text-sm text-yellow-700">
            <strong>注意：</strong> 既に家族コード「<%= current_user.family.family_code %>」に所属しています。<br>
            新しいコードを入力すると、現在の家族グループから移動します。
          </p>
        </div>
      <% end %>
    </div>

    <%= form_with url: family_join_path, method: :post, local: true do |f| %>
      <div class="mb-4">
        <%= label_tag :family_code, '家族コード', class: 'block text-gray-700 font-bold mb-2' %>
        <%= text_field_tag :family_code, 
            params[:family_code],
            placeholder: '例: ABC12345',
            maxlength: 8,
            class: 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 text-center text-2xl tracking-wider uppercase',
            required: true %>
        <p class="text-sm text-gray-500 mt-1">
          ※ 8文字の英数字を入力してください
        </p>
      </div>

  <div>
    <%= submit_tag '連携する', 
        class: 'btn-common',
        data: { turbo_confirm: current_user.family.present? ? '現在の家族グループから移動しますがよろしいですか？' : nil } %>
    <%= link_to '戻る', family_connection_select_path, 
        class: 'btn-common' %>
  </div>
      </div>
    <% end %>
  </div>
</div>
