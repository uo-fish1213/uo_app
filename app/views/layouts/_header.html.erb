<header class="header">
  <div class="header-container">
    <h1 class="header-logo">
      ペアプリtotomo
    </h1>
    
    <% unless @simple_header %>
      <nav class="header-nav">
        <% if logged_in? %>
          <%# プリント一覧ページ以外で「プリント一覧」リンクを表示 %>
          <%= link_to 'プリント一覧', prints_path, class: 'header-nav-link' unless current_page?(prints_path) %>
          
          <%# プリント一覧ページでのみ「家族連携」ボタンを表示 %>
          <% if current_page?(prints_path) %>
          <%= link_to '家族と連携する', select_family_connection_path, class: 'header-nav-link' %>
          <% end %>
          
          <%= link_to 'ログアウト', logout_path, data: { turbo_method: :delete }, class: 'header-nav-link' %>
        <% else %>
          <%= link_to 'ログイン', login_path, class: 'header-nav-link' %>
          <%= link_to '新規登録', new_user_path, class: 'header-nav-link' %>
        <% end %>
      </nav>
    <% end %>
  </div>
</header>