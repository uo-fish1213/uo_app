<header class="header">
  <div class="header-container">
    <h1 class="header-logo">
      <% if @simple_header %>
        ペアプリtotomo
      <% else %>
        <%= link_to 'ペアプリtotomo', root_path, class: 'header-logo-link' %>
      <% end %>
    </h1>
    
    <% unless @simple_header %>
      <nav class="header-nav">
        <% if logged_in? %>
          <%= link_to 'プリント一覧', prints_path, class: 'header-nav-link' %>
          <%= link_to 'ログアウト', logout_path, method: :delete, class: 'header-nav-link' %>
        <% else %>
          <%= link_to 'ログイン', login_path, class: 'header-nav-link' %>
          <%= link_to '新規登録', new_user_path, class: 'header-nav-link' %>
        <% end %>
      </nav>
    <% end %>
  </div>
</header>