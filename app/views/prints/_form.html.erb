<%# app/views/prints/_form.html.erb %>
<%= form_with model: print, data: { turbo: false } do |f| %>
  <%= render 'shared/error_messages', object: f.object %>
  
  <div class="mb-5">
    <%= f.label :image, "画像", class: "form-label" %>
    <%= f.file_field :image, class: "form-control", accept: 'image/*' %>
  </div>
  
  <div class="mb-5">
    <%= f.label :child_tag, "子ども選択", class: "form-label" %>
    <%= f.select :child_tag, 
                 Print.child_tags.keys.map { |k| [I18n.t("enums.print.child_tag.#{k}"), k] }, 
                 { prompt: "選択してください" }, 
                 class: "form-select" %>
  </div>
  
  <div class="mb-5">
    <%= f.label :action_tag, "アクションタグ", class: "form-label" %>
    <%= f.select :action_tag, 
                 Print.action_tags.keys.map { |k| [I18n.t("enums.print.action_tag.#{k}"), k] }, 
                 { prompt: "選択してください" }, 
                 class: "form-select" %>
  </div>
  
  <div class="mb-5">
    <%= f.label :deadline, "期限", class: "form-label" %>
    <%= f.date_field :deadline, class: "form-control" %>
  </div>
  
  <div class="text-center mt-4">
    <%= f.submit "保存", class: "btn btn-primary" %>
  </div>
<% end %>