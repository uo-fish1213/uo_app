<div class="prints-container">
  <h1>プリント一覧</h1>
  
  <% if @prints.any? %>
    <div class="prints-grid">
      <% @prints.each do |print| %>
        <div class="print-card">
          <!-- 画像(クリックで詳細画面へ) -->
          <%= link_to print_path(print), class: 'print-image-link' do %>
            <div class="print-image">
              <% if print.image? %>
                <%= image_tag print.image.url, alt: "プリント画像", class: 'print-thumbnail' %>
              <% else %>
                <div class="no-image">
                  <i class="bi bi-image"></i>
                  <p>画像なし</p>
                </div>
              <% end %>
            </div>
          <% end %>
          
          <!-- カード情報エリア -->
          <div class="print-info">
            <!-- タグ -->
            <div class="print-tags">
              <span class="tag child-tag">
                <i class="bi bi-person"></i>
                <%= print.child_tag_i18n %>
              </span>
              <span class="tag action-tag">
                <i class="bi bi-lightning"></i>
                <%= print.action_tag_i18n %>
              </span>
            </div>
            
            <!-- 締め切り -->
            <div class="print-deadline">
              <i class="bi bi-calendar-event"></i>
              <span class="deadline-text">
                <%= print.deadline.strftime('%Y/%m/%d') if print.deadline.present? %>
              </span>
            </div>
          </div> <!-- ← ここに > を追加! -->
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- プリントがない場合 -->
    <div class="no-prints">
      <i class="bi bi-inbox"></i>
      <p>プリントがまだありません</p>
    </div>
  <% end %>
</div>