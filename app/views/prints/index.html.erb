<div class="prints-container">
  <h1>プリント一覧</h1>
  
  <% if @prints.any? %>
    <table class="prints-table">
      <thead>
        <tr>
          <th>画像</th>
          <th>子供</th>
          <th>アクション</th>
          <th>締め切り</th>
        </tr>
      </thead>
      <tbody>
        <% @prints.each do |print| %>
          <tr>
            <!-- 画像 -->
            <td>
              <%= link_to print_path(print) do %>
                <% if print.image.present? %>
                  <%= image_tag print.image.url, class: 'print-thumbnail' %>
                <% else %>
                  <span class="no-image">画像なし</span>
                <% end %>
              <% end %>
            </td>
            
            <!-- 子どもタグ(文字列として表示) -->
            <td>
              <span class="tag tag-child"><%= print.child_tag %></span>
            </td>
            
            <!-- アクションタグ(文字列として表示) -->
            <td>
              <span class="tag tag-action"><%= print.action_tag %></span>
            </td>
            
            <!-- 締め切り -->
            <td>
              <%= l print.deadline, format: :short %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="no-data">プリントがまだありません</p>
  <% end %>
</div>