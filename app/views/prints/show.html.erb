<div class="print-detail">
  <!-- プリント画像 -->
  <% if @print.image? %>
  <%= image_tag @print.image.url(expires_in: 1.day), class: 'print-image', alt: 'プリント画像' %>
  <% else %>
    <div class="print-image-placeholder">
      <span class="placeholder-text">
        <i class="bi bi-image"></i>
        画像が登録されていません
      </span>
    </div>
  <% end %>
  
  <!-- 締め切り日 -->
  <p>締め切り日: <%= @print.deadline %></p>
  
  <!-- 子供タグ -->
  <p>子供: <%= @print.child_tag_i18n %></p>
  
  <!-- アクションタグ -->
  <p>アクション: <%= @print.action_tag_i18n %></p>
  
   <!-- ボタン -->
  <%= form_with model: @print, method: :delete, local: true do |f| %>
  <%= f.submit '削除', 
      data: { confirm: '本当に削除しますか?' }, 
      class: "btn btn-common" %>
  <% end %> 
  <!-- プリント一覧へ戻るボタンを追加 -->
  <%= link_to 'プリント一覧へ戻る', prints_path, class: "btn btn-common" %>
</div>